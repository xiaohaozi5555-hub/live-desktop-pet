{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PerceptionMessage",
  "type": "object",
  "required": ["channel", "type", "ts", "data"],
  "properties": {
    "channel": { "const": "perception" },
    "type": {
      "type": "string",
      "enum": [
        "danmaku.enter",
        "danmaku.chat",
        "danmaku.gift",
        "danmaku.like",
        "danmaku.follow",
        "danmaku.health",
        "face.expression",
        "game.scene",
        "game.scare",
        "plugin.state",
        "audio.command",
        "audio.self_speaking"
      ]
    },
    "ts": { "type": "integer" },
    "source": { "type": "string" },
    "data": { "type": "object" }
  }
}
