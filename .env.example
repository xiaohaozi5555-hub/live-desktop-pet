PET_VISION_BASE_URL=
PET_VISION_API_KEY=
PET_VISION_MODEL=

# 文生图（角色立绘）：复用同一个 DashScope key，模型换成通义万相
PET_IMAGE_MODEL=

# 对话服务（services/dialogue）——DeepSeek，OpenAI 兼容协议
PET_CHAT_BASE_URL=
PET_CHAT_API_KEY=
PET_CHAT_MODEL=

# 语音唤醒词：喊到它才开始一段对话窗口（窗口内 18 秒免重复唤醒）。
# 留空会导致带对话窗口的语音永远不转发（has_wake 恒 false + 窗口初始关闭），所以必须设。
PET_WAKE_WORD=

# 合规护栏开关。BANNED_WORDS 那张表来自抖音直播玩法准入规则，是为上架平台服务的。
# 2026-07-26 已决定不走官方上架、改做自用程序，这张表不再是硬约束（"游戏"这类词日常都在说）。
# 代码默认仍是 on，规则本身保留；自用场景在这里关掉。要重新对外提交时删掉这行即可。
PET_GUARDRAILS=

# 指定麦克风：设备序号或名字片段。不设则跟随系统默认——但外接麦一断开，系统会静悄悄
# 切回主板声卡，表现就是"喊她完全没反应"且日志看不出原因（实测踩过）。所以钉死。
PET_MIC=

# 声纹判定阈值。实测本人语音 0.76~0.82、静音底噪 0.46~0.47，0.75 贴着本人下沿容易误拒。
PET_VOICE_THRESHOLD=
